# console.benjaminberger.at — Xeon-1 live dashboard (Node app on 127.0.0.1:3120).
# Behind Cloudflare (proxied): edge TLS to the browser, wildcard LE cert to the origin.
# Only Cloudflare (and localhost) may reach this vhost.

geo $realip_remote_addr $dash_from_cf {
    default 0;
    127.0.0.1 1;
    ::1 1;
    173.245.48.0/20 1;
    103.21.244.0/22 1;
    103.22.200.0/22 1;
    103.31.4.0/22 1;
    141.101.64.0/18 1;
    108.162.192.0/18 1;
    190.93.240.0/20 1;
    188.114.96.0/20 1;
    197.234.240.0/22 1;
    198.41.128.0/17 1;
    162.158.0.0/15 1;
    104.16.0.0/13 1;
    104.24.0.0/14 1;
    172.64.0.0/13 1;
    131.0.72.0/22 1;
    2400:cb00::/32 1;
    2606:4700::/32 1;
    2803:f800::/32 1;
    2405:b500::/32 1;
    2405:8100::/32 1;
    2a06:98c0::/29 1;
    2c0f:f248::/32 1;
}

limit_req_zone  $binary_remote_addr zone=dash_api:10m rate=20r/s;
limit_req_zone  $binary_remote_addr zone=dash_auth:10m rate=6r/s;
limit_conn_zone $binary_remote_addr zone=dash_conn:10m;

upstream server_dash { server 127.0.0.1:3120; keepalive 8; }

server {
    listen 80;
    listen [::]:80;
    server_name console.benjaminberger.at;
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name console.benjaminberger.at;

    ssl_certificate     /etc/ssl/cloudflare-origin/benjaminberger.at/fullchain.pem;
    ssl_certificate_key /etc/ssl/cloudflare-origin/benjaminberger.at/privkey.pem;
    include /etc/nginx/snippets/tls-settings.conf;
    ssl_dhparam /etc/ssl/dhparams.pem;

    include snippets/cloudflare-real-ip.conf;
    if ($dash_from_cf = 0) { return 444; }

    access_log /var/log/nginx/console.benjaminberger.at.access.log;
    error_log  /var/log/nginx/console.benjaminberger.at.error.log;

    server_tokens off;
    client_max_body_size 16k;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";

    # Live stream (SSE): no buffering, long-lived, a few per visitor.
    location = /api/stream {
        limit_conn dash_conn 6;
        proxy_pass http://server_dash;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Login and password endpoints: tight limit on top of the app's own lockouts.
    location /auth/ {
        limit_req zone=dash_auth burst=10 nodelay;
        client_max_body_size 8k;
        proxy_pass http://server_dash;
    }

    # Uploads stream straight to the app (Cloudflare itself caps requests at 100 MB).
    location = /api/upload {
        limit_req zone=dash_api burst=10 nodelay;
        client_max_body_size 95m;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass http://server_dash;
    }

    # Downloads: no buffering, long timeout for big files.
    location = /api/download {
        limit_req zone=dash_api burst=10 nodelay;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_pass http://server_dash;
    }

    # Actions carry file contents from the editor (up to 2 MB) and some take long (traceroute, apt queries).
    location = /api/action {
        limit_req zone=dash_api burst=40 nodelay;
        client_max_body_size 3m;
        proxy_read_timeout 200s;
        proxy_pass http://server_dash;
    }

    # Notes, saved commands and favourites travel as one JSON document (up to ~1.5 MB).
    location = /api/userdata {
        limit_req zone=dash_api burst=40 nodelay;
        client_max_body_size 2m;
        proxy_pass http://server_dash;
    }

    location /api/ {
        limit_req zone=dash_api burst=40 nodelay;
        proxy_pass http://server_dash;
    }

    location / {
        proxy_pass http://server_dash;
    }
}
